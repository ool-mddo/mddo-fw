version 26.2R1.7;
system {
    host-name site-c-cr-1;
    root-authentication {
        encrypted-password "$6$UQCSVUVj$J5dKxgUTpmKjCx6f2NmsPAwI9fdCMHJWA5weJwYfti8AtT1YmkPjanqtSRUPkCniJ0bnC1xVyM5LoBRT97SUW0"; ## SECRET-DATA
    }
    services {
        ssh {
            root-login allow;
        }
    }
    syslog {
        file interactive-commands {
            interactive-commands any;
        }
        file messages {
            any notice;
            authorization info;
        }
    }
}
interfaces {
    ge-0/0/0 {
        description to_site-c-fw-1_ge-0/0/2;
        unit 0 {
            family inet {
                address 192.168.21.2/30;
            }
        }
    }
    ge-0/0/1 {
        description to_site-c-cr-2_ge-0/0/1;
        unit 0 {
            family inet {
                address 192.168.20.1/30;
            }
        }
    }
    ge-0/0/2 {
        description to_site-c-seg1;
        unit 0 {
            family inet {
                address 192.168.102.2/24 {
                    vrrp-group 1 {
                        virtual-address 192.168.102.1;
                        priority 150;
                        accept-data;
                    }
                }
            }
        }
    }
    ge-0/0/3 {
        description to_site-c-seg2;
        unit 0 {
            family inet {
                address 192.168.202.2/24 {
                    vrrp-group 2 {
                        virtual-address 192.168.202.1;
                        priority 150;
                        accept-data;
                    }
                }
            }
        }
    }
    fxp0 {
        unit 0 {
            family inet {
                address 192.168.23.127/24;
            }
        }
    }
}
protocols {
    ospf {
        area 0.0.0.30 {
            interface ge-0/0/0.0 {
                interface-type p2p;
            }
            interface ge-0/0/1.0 {
                interface-type p2p;
            }
            interface ge-0/0/2.0 {
                passive;
            }
            interface ge-0/0/3.0 {
                passive;
            }
        }
    }
}